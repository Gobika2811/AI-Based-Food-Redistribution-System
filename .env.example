# ==============================================================================
# ResQFood Environment Variables Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

# Core Application Settings
APP_NAME=ResQFood
APP_ENV=development
DEBUG=true
SECRET_KEY=supersecretjwtsecretkeychangeinproduction123!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend FastAPI Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# AI Service FastAPI Settings
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://127.0.0.1:8001

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/resqfood
# Docker-based PostgreSQL URL (use inside docker-compose)
# DATABASE_URL=postgresql://postgres:admin123@db:5432/resqfood

# Redis and Celery Broker
REDIS_URL=redis://localhost:6379/0
# Docker-based Redis URL (use inside docker-compose)
# REDIS_URL=redis://redis:6379/0

# Cloudinary Integration (for product/surplus images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Default Admin Seed Account
DEFAULT_ADMIN_EMAIL=admin@resqfood.org
DEFAULT_ADMIN_PASSWORD=adminpassword123
